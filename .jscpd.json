{
  "$schema": "https://raw.githubusercontent.com/kucherenko/jscpd/master/packages/jscpd/schema.json",
  "threshold": 3,
  "reporters": ["console", "html"],
  "output": "./reports/jscpd",
  "format": ["typescript", "tsx", "javascript", "jsx", "css"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/test-setup.ts",
    "**/*.d.ts"
  ],
  "absolute": true,
  "gitignore": true,
  "minLines": 10,
  "minTokens": 70
}
